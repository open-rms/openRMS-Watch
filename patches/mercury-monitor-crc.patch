@@ -54,6 +54,18 @@
 #include "modem.h"
 #include "mercury_cli.h"
 #include "framer.h"
+
+/* Address the TCP listeners bind to.  MERCURY_BIND_ADDR=127.0.0.1 keeps the
+ * control, data and broadcast ports off the network (openRMS-Watch runs its
+ * receive-only monitors that way); unset or unparseable: every interface. */
+static uint32_t tcp_bind_addr(void)
+{
+    const char *a = getenv("MERCURY_BIND_ADDR");
+    struct in_addr ia;
+    if (a && a[0] && inet_pton(AF_INET, a, &ia) == 1)
+        return ia.s_addr;
+    return htonl(INADDR_ANY);
+}
 #include "hermes_log.h"
 #include "radio_io.h"
 #include "modem.h"

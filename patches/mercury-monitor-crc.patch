diff --git i/datalink_arq/arq.c w/datalink_arq/arq.c
index dafcabe8..c1c61365 100644
--- i/datalink_arq/arq.c
+++ w/datalink_arq/arq.c
@@ -77,10 +77,24 @@ static arq_timing_ctx_t g_timing;
  * mingw-w64 winpthreads provides the non-suffixed PTHREAD_RECURSIVE_MUTEX_
  * INITIALIZER (and not the _NP one), so fall back to it for the Windows
  * cross-compile. */
+#if !defined(PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP) && !defined(PTHREAD_RECURSIVE_MUTEX_INITIALIZER)
+/* musl has neither static initializer: make the lock recursive before main()
+ * runs, which is before any thread can take it. */
+static pthread_mutex_t  g_sess_lock;
+__attribute__((constructor)) static void g_sess_lock_init(void)
+{
+    pthread_mutexattr_t a;
+    pthread_mutexattr_init(&a);
+    pthread_mutexattr_settype(&a, PTHREAD_MUTEX_RECURSIVE);
+    pthread_mutex_init(&g_sess_lock, &a);
+    pthread_mutexattr_destroy(&a);
+}
+#else
 #ifndef PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP
 #define PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP PTHREAD_RECURSIVE_MUTEX_INITIALIZER
 #endif
 static pthread_mutex_t  g_sess_lock = PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP;
+#endif
 
 /* App TX ring buffer (data from TCP client) */
 #define APP_TX_BUF_SIZE (64 * 1024)

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // watch.openrms.dev: assets-only Worker on the same Cloudflare account as openrms.dev.
  "name": "openrms-watch-site",
  "account_id": "5ded550beb08feb732e46a624c8939a4",
  "compatibility_date": "2026-11-26",
  "routes": [{ "pattern": "watch.openrms.dev", "custom_domain": true }],
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openRMS Watch",
  "version": "0.1.0",
  "identifier": "dev.openrms.watch",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "See the Mercury RMS stations your SDR hears",
    "longDescription": "Desktop window and tray icon for openrms-watch, which scans HF bands with an SDR, decodes Mercury connections, and optionally contributes what it hears to openRMS.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "license": "AGPL-3.0-or-later",
    "linux": {
      "deb": {
        "depends": [
          "libsoapysdr0.8"
        ]
      },
      "rpm": {
        "depends": [
          "SoapySDR"
        ]
      }
    },
    "externalBin": [
      "binaries/openrms-watch"
    ],
    "resources": {
      "resources/mercury": "mercury",
      "../packaging/watch.toml.default": "watch.toml.default",
      "../packaging/mercury-SOURCE.txt": "mercury-SOURCE.txt"
    }
  }
}

# openrms-watch configuration. Most of this is edited from the web page
# (Settings tab); hand edits are kept.
[watch]
mercury = "@LIBDIR@/mercury"
db = "watch.db"                 # relative to this file
listen = "127.0.0.1:@PORT@"
stale_hours = 24
gone_days = 7
connect_only = true

[[receiver]]
id = "sdr"
name = ""
kind = "local-sdr"
location = ""                   # your grid square
ppm = 0

# No SDR chosen yet: open the web page, Settings tab, pick your SDR and bands.

[directory]
# url = "https://..."           # the openRMS site; names stations and enables contributing

[contribute]
enabled = false

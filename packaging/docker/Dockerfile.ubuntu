# Build environment for release tarballs: Ubuntu 22.04 (glibc 2.35, SoapySDR 0.8),
# so binaries also run on Debian 12, Raspberry Pi OS 12, Fedora, Arch and newer
# Ubuntu. Built per platform with buildx (amd64, arm64, arm/v7, riscv64).
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config curl ca-certificates git \
      libsoapysdr-dev libasound2-dev libpulse-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /src

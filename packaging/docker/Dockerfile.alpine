# musl build for Alpine Linux (dynamic: SoapySDR loads driver modules at runtime,
# which a fully static binary cannot do). Rust comes from rustup: Alpine's own
# package can be older than the 2024 edition needs.
FROM alpine:3.22
RUN apk add --no-cache build-base pkgconf curl git bash \
      soapy-sdr-dev alsa-lib-dev pulseaudio-dev linux-headers
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH
# link dynamically: musl Rust defaults to static, and SoapySDR has to be a
# shared library to load its driver modules
ENV RUSTFLAGS="-C target-feature=-crt-static"
WORKDIR /src
